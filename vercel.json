{
  "buildCommand": "cd staff/frontend && npm install && npm run build",
  "outputDirectory": "staff/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mrchange-qjrl.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://mrchange-qjrl.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
